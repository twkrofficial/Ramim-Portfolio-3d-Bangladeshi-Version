.notifications

    --max-width @css{ min(350px, calc(100% - 40px)) }

    html.is-mode-touch &
        --max-width @css{ min(350px, calc(100% - 88px)) }

    position absolute
    top 20px
    left calc(50% - var(--max-width) / 2)
    right 0
    width var(--max-width)

    .items
        position absolute
        top 0
        left 0
        width 100%

    .notification
        position relative
        width 100%
        padding 12px 20px 15px 22px
        background #1a4438
        font-size 16px
        cursor pointer
        -webkit-user-select none
        -moz-user-select none
        user-select none
        transform translateY(calc(-100% - 20px))
        transition transform 0.6s cubic-bezier(0.4, 1.6, 0.65, 1)

        &.is-visible
            transform translateY(0)

        &.is-leaving
            transform translateY(calc(-100% + 20px)) scale(0, 0)
            transition-timing-function cubic-bezier(0.42, 0, 0.47,-0.55)
            transition-duration 0.45s

        html:not(.is-mode-touch) &:hover
            .bottom
                .open-icon
                    opacity 1

        // Jhalot scallop edge (r=6): marigold half-circle chain on the left side
        &::before
            content ''
            position absolute
            top 0
            left 0
            bottom 0
            width 6px
            background-image radial-gradient(circle at 0 6px, #f5a800 6px, transparent 6.5px)
            background-size 6px 12px
            background-repeat repeat-y
            pointer-events none

        .time-bar
            position absolute
            top 0
            left 0
            width 100%
            height 2px
            background #f5a800
            transform-origin 100% 0
            will-change transform

        &.is-achievement
            // padding 12px 20px 15px 15px

            .top
                display flex
                justify-content space-between
                align-items center
                margin-bottom 5px

                .title
                    text-align left
                    color #4ccb5f
                    font-size 1.7rem
                    margin-right 10px
                    margin-bottom 0
                    line-height 1em
                    margin-bottom 0.25em

                .progress
                    display flex
                    align-items center
                    font-weight 700
                    color #4ccb5f

                    .check-icon
                        display block
                        width 17px
                        height 13px
                        margin-right 10px
                        background url(../ui/achievements/check.svg)

            .bottom
                display flex
                justify-content space-between
                align-items flex-start

                .description
                    margin-right 10px
                    margin-bottom 0
                    color #f6ead2
                    line-height 1em
                    font-size 16px
                
                .open-icon
                    display block
                    position relative
                    top 1px
                    width 19px
                    height 19px
                    background url('../ui/actions/actions-icon-open.webp')
                    background-size 19px 19px
                    opacity 0
                    transition opacity 0.1s

            .time-bar
                background #2e9e4f


        &.is-song
            .top
                display flex
                justify-content space-between
                align-items center

                .title
                    text-align left
                    color #f5a800
                    font-size 1.7rem
                    margin-bottom 0
                    line-height 1em

                    .song-name
                        color #f6ead2

                .music-note-icon
                    display block
                    width 16px
                    height 18px
                    background url(../ui/music-note.svg)

            .time-bar
                background #f5a800

        &.is-server-connected
            .top
                .title
                    text-align left
                    color #4ccb5f
                    font-size 1.7rem
                    margin-bottom 0
                    line-height 1em

            .time-bar
                background #2e9e4f

        &.is-server-disconnected
            .top
                .title
                    text-align left
                    color #e03a4e
                    font-size 1.7rem
                    margin-bottom 0
                    line-height 1em

            .time-bar
                background #c8102e
